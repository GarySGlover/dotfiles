;;; kanata --- Summary
;;; Commentary:

;;; Code:
(defcfg
 process-unmapped-keys yes)

(defsrc)

(deftemplate ctrl-fork-u (orig new)
             $orig (fork $orig (multi (unmod (lctrl rctrl) nop0) $new) (lctrl rctrl)))
(deftemplate ctrl-fork (orig new)
             $orig (fork $orig $new (lctrl rctrl)))
(deftemplate layer-switch (layer)
             l (switch
                ((and (or (input real lctrl) (input real rctrl)) (or (input real lmeta) (input real rmeta)))) (layer-switch $layer) break
                () l break))

(deflayermap base
             (t! layer-switch emacs-emulation)
             )

(deflayermap emacs-emulation
             (t! layer-switch base)
             (t! ctrl-fork-u p ArrowUp)
             (t! ctrl-fork-u n ArrowDown)
             (t! ctrl-fork-u b ArrowLeft)
             (t! ctrl-fork-u f ArrowRight)
             (t! ctrl-fork s f))

;;; kanata.kbd ends here
